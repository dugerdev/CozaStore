# CozaStore - Environment Variables
# WebAPI ve WebUI appsettings.json kullanır. Docker/CI için:

ConnectionStrings__DefaultConnection=Server=localhost;Database=CozaStoreDb;Trusted_Connection=True;TrustServerCertificate=True
JwtSettings__SecretKey=your-min-32-character-secret-key
JwtSettings__Issuer=CozaStoreAPI
JwtSettings__Audience=CozaStoreClient
ApiSettings__BaseUrl=https://localhost:7001/api
ASPNETCORE_ENVIRONMENT=Development
